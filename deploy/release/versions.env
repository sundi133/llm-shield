# Pinned inputs for release builds (.github/workflows/release.yml). Builds on
# main keep using the Dockerfile defaults; a release must be reproducible, so
# it pins these. Change them in a PR, never in the workflow.

# vLLM base for the GPU image (Dockerfile ARG VLLM_BASE_IMAGE). Tag for
# readability, digest for the exact bits. v0.33.0 is what main's
# vllm/vllm-openai:latest resolved to on 2026-11-04.
VLLM_BASE_IMAGE=docker.io/vllm/vllm-openai:v0.33.0@sha256:d825baf9ce4b1b6bfc5ecc7b79880c7e6748c65a72d697ce3d47607aafa84c6e

# Redis the bundle ships (pinned by digest in the bundle's overlays).
REDIS_IMAGE=docker.io/library/redis:7.4-alpine
