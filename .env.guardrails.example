# Local guardrails testing stack - copy to .env.guardrails and edit if needed.
#
#   cp .env.guardrails.example .env.guardrails
#   docker compose -f docker-compose.guardrails.yml --env-file .env.guardrails up -d
#
# Every value here is a NON-SECRET local default. Nothing in this file is a real
# credential, and .env.guardrails is gitignored so your edited copy never ships.

# ── Ports (all bind to 127.0.0.1 only, never 0.0.0.0) ───────────────────────
# Change these if something already owns the port on your machine.
SHIELD_PORT=8000        # data plane  → http://127.0.0.1:8000  (/guardrails/*)
ADMIN_PORT=8080         # admin plane → http://127.0.0.1:8080  (tenant portal)
LLAMA_PORT=8081         # guardrail model server (llama.cpp)
REDIS_PORT=6379         # Redis, published so you can redis-cli into it

# ── Guardrail model ────────────────────────────────────────────────────────
# The shipped Votal guardrail model in CPU-runnable GGUF form. Public on
# Hugging Face - no token required. Pulled once (~5.2GB) into a named volume,
# so `down` / `up` does not re-download it.
#
# Referenced by core/llm_backend.py:218,425-426 and
# docs/installation-guide.md:697-710.
LLAMA_HF_REPO=votal-ai/Qwen3.5-9B-guardrailed-v3-GGUF
LLAMA_HF_FILE=Qwen3.5-9B-guardrailed-Q4_K_M.gguf

# Context window and parallel slots. Small on purpose: this is a laptop, and
# guardrail prompts are short. Raising these costs RAM.
LLAMA_CTX_SIZE=8192
LLAMA_PARALLEL=2

# CPU threads llama.cpp may use. 0 lets llama.cpp pick. Setting this to roughly
# your physical core count (not hyperthread count) is usually fastest.
LLAMA_THREADS=0

# ── Credentials (LOCAL ONLY - never reuse these anywhere real) ─────────────
# Admin-plane key, sent as X-Admin-Key. Guards tenant CRUD.
SHIELD_ADMIN_KEY=local-dev-admin-key

# core/auth.py:146-150 returns HTTP 500 on EVERY request when auth is enabled
# and this list is empty - before any tenant lookup runs. So it must be set.
# The smoke script does NOT use this key: it authenticates with the tenant key
# it mints, which exercises the Redis-backed branch the way production does.
SHIELD_BOOTSTRAP_API_KEY=local-bootstrap-key

# ── Data plane tuning ──────────────────────────────────────────────────────
# handler.py defaults to 32 uvicorn workers. That is a server default; on a
# laptop it just slows boot and multiplies memory for no benefit.
SHIELD_WORKERS=4
