# Lightweight admin-only image — no GPU, no models, no llama.cpp.
# Serves the admin/tenant portals and tenant CRUD APIs. Talks to the
# same Redis as the production guardrail workers.
#
# Build:
#   docker build -f Dockerfile.admin -t shield-admin .
#
# Run:
#   docker run -p 8080:8080 \
#     -e UPSTASH_REDIS_REST_URL=https://correct-mongoose-70933.upstash.io \
#     -e UPSTASH_REDIS_REST_TOKEN=... \
#     -e SHIELD_ADMIN_KEY=... \
#     shield-admin

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Install minimal Python deps.
# shield-mcp is installed from the local path, so its source has to be present
# BEFORE pip runs — otherwise the build fails on a requirement it cannot resolve.
COPY requirements-admin.txt .
COPY packages/shield-mcp/ packages/shield-mcp/
RUN pip install --no-cache-dir -r requirements-admin.txt

# Copy only the modules needed for admin/tenant UI
COPY admin_app.py .
COPY config/__init__.py config/
COPY config/schema.py config/
COPY core/__init__.py core/
COPY core/auth.py core/
COPY core/middleware.py core/
COPY core/rbac.py core/
COPY core/feature_flags.py core/
COPY core/policy_inheritance.py core/
# Imported at module load by api/routes_tool.py (which this image COPYs), so
# their absence crash-loops the admin container at boot.
COPY core/policy_mode.py core/
COPY core/run_context.py core/
# Onboarding scan (admin plane only; the scanner import is optional).
COPY core/mcp_scan.py core/
# OAuth brokering for upstream MCP servers (admin plane only).
COPY core/mcp_oauth.py core/
COPY core/webhook_dispatcher.py core/
COPY core/models.py core/
COPY core/llm_backend.py core/
# Security hardening — IEMLabs VAPT fixes (May 2026)
COPY core/url_safety.py core/
COPY core/security_headers.py core/
# Agent AuthN/AuthZ feature
COPY core/identity.py core/
COPY core/signers.py core/
COPY core/agent_tokens.py core/
COPY core/capabilities.py core/
COPY core/approvals.py core/
COPY core/agent_identity_middleware.py core/
COPY core/agent_auth_safety.py core/
COPY core/jwt_utils.py core/
COPY core/mtls_middleware.py core/
# Identity resolution seam. core/middleware.py imports identity_resolution, and
# routes_agent_identity imports workload_identity — both TRANSITIVELY, which is
# how they were missed: the admin allowlist guard only checked what admin_app.py
# imports directly. Omitting these 500s every request through the middleware.
COPY core/identity_resolution.py core/
COPY core/delegation.py core/
COPY core/dpop.py core/
COPY core/workload_identity/ core/workload_identity/
COPY core/proxy_trust.py core/
# OAuth / OIDC / SPIFFE modules
COPY core/oauth/ core/oauth/
# A2A protocol
COPY core/a2a/ core/a2a/
COPY api/__init__.py api/
COPY api/routes_tenant.py api/
COPY api/routes_tenant_self.py api/
COPY api/routes_agents_registry.py api/
COPY api/routes_governance.py api/
COPY api/routes_edge.py api/
COPY api/routes_custom_policies.py api/
COPY api/routes_data_policies.py api/
COPY api/routes_audit.py api/
COPY api/routes_policy.py api/
COPY api/routes_killswitch.py api/
COPY api/routes_decisions.py api/
COPY api/routes_webhooks.py api/
COPY api/routes_agent_identity.py api/
COPY api/routes_agent_auth.py api/
COPY api/routes_oauth.py api/
COPY api/routes_oauth_registration.py api/
COPY api/routes_oidc_admin.py api/
COPY api/routes_a2a.py api/
COPY api/routes_agentic_control_plane.py api/
COPY api/routes_guardrail_metrics.py api/
COPY api/routes_siem.py api/
COPY api/routes_vault.py api/
COPY api/routes_evidence.py api/
COPY api/routes_board_report.py api/
COPY api/routes_aibom.py api/
COPY api/routes_mcp_admin.py api/
COPY api/routes_tool.py api/
COPY api/routes_config.py api/
COPY storage/__init__.py storage/
COPY storage/tenant_store.py storage/
COPY storage/tenant_models.py storage/
COPY storage/admin_audit.py storage/
COPY storage/custom_policies.py storage/
COPY storage/rate_limiter.py storage/
COPY storage/policy_store.py storage/
COPY storage/audit_log.py storage/
COPY storage/audit_chain.py storage/
COPY storage/state_store.py storage/
COPY storage/decision_audit.py storage/
COPY storage/tool_killswitch.py storage/
COPY storage/webhook_store.py storage/
COPY storage/revocation.py storage/
COPY storage/agent_auth_stats.py storage/
COPY storage/oauth_store.py storage/
COPY storage/agentic_control_plane.py storage/
COPY storage/guardrail_metrics.py storage/
COPY storage/siem_store.py storage/
COPY core/siem_dispatcher.py core/
COPY storage/vault_store.py storage/
COPY core/secret_vault/ core/secret_vault/
COPY storage/evidence_pack.py storage/
# AIBOM (AI Bill of Materials) — generator + the gateway store it reads
COPY storage/aibom.py storage/
COPY storage/aibom_mappings.py storage/
COPY storage/aibom_interop.py storage/
COPY storage/mcp_gateway_store.py storage/
COPY storage/mcp_policy_store.py storage/
COPY storage/mcp_scan_store.py storage/
COPY storage/mcp_oauth_store.py storage/
COPY core/telemetry.py core/
COPY guardrails/__init__.py guardrails/
COPY guardrails/base.py guardrails/
# Imported at module load by api/routes_config.py.
COPY guardrails/registry.py guardrails/
COPY guardrails/agentic/__init__.py guardrails/agentic/
COPY guardrails/agentic/rbac_guard.py guardrails/agentic/
COPY guardrails/agentic/data_access_guard.py guardrails/agentic/
COPY guardrails/agentic/identity/ guardrails/agentic/identity/
COPY guardrails/agentic/scope/ guardrails/agentic/scope/
COPY guardrails/agentic/intent/ guardrails/agentic/intent/
COPY guardrails/agentic/taint/ guardrails/agentic/taint/
COPY guardrails/agentic/tool/ guardrails/agentic/tool/
COPY static/ static/

EXPOSE 8080
CMD ["python3", "admin_app.py"]
