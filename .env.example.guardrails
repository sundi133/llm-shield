# LLM Shield Guardrails Testing Environment Variables
# Copy this file to .env and fill in your actual values

# RunPod/API Authentication Token
RUNPOD_TOKEN=rpa_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Alternative auth token variable name
AUTH_TOKEN=your_auth_token_here

# API Key for tenant access
API_KEY=tenant-YYYYMMDDHHMMSS-XXXXXX-key-XXXXXX
# Alternative API key variable name
X_API_KEY=your_x_api_key_here

# Tenant ID for testing
TENANT_ID=tenant-YYYYMMDDHHMMSS-XXXXXX

# Optional: Base URL (defaults to placeholder in script)
BASE_URL=https://your-llm-shield-endpoint.com

# --- Guard model mode (data plane) ---
# Which model(s) vLLM serves AND the app's client uses for guard classification.
# Default: votal (unchanged / non-breaking). Applies ONLY to guardrail calls;
# gateway user chat traffic is never rerouted.
#   votal    -> serve VOTAL_MODEL_NAME on VLLM_PORT
#   nemotron -> serve NEMOTRON_MODEL on VLLM_PORT
#   both     -> serve Votal on VLLM_PORT + Nemotron on NEMOTRON_VLLM_PORT (verdicts merged)
# SHIELD_GUARD_MODEL_MODE=votal|nemotron|both
#
# Models served by start_vllm.sh (self-hosted vLLM path):
# VOTAL_MODEL_NAME=votal-ai/vai35-4B-v2
# NEMOTRON_MODEL=nvidia/Nemotron-3.5-Content-Safety
# NEMOTRON_SERVED_NAME=nemotron_moderator      # vLLM --served-model-name
# VLLM_PORT=8000
# NEMOTRON_VLLM_PORT=8001                       # second instance in 'both' mode
#
# start_vllm.sh auto-exports NEMOTRON_BACKEND_URL / NEMOTRON_MODEL_NAME for the
# client. Set these manually ONLY when using an external/NIM backend (SKIP_VLLM):
# NEMOTRON_BACKEND_URL=https://your-nemotron-endpoint
# NEMOTRON_MODEL_NAME=nemotron_moderator
# NEMOTRON_BACKEND_API_KEY=your-nim-api-key
# In 'both' mode, whose verdict wins on a tie. Default: votal.
# SHIELD_GUARD_MODEL_PRIMARY=votal|nemotron

# --- CORS (data plane, opt-in) ---
# Comma-separated origins allowed to call the API from a browser (e.g. the
# bundled extension). Unset = no CORS headers (default). Never use "*".
# SHIELD_CORS_ALLOW_ORIGINS=chrome-extension://your-extension-id