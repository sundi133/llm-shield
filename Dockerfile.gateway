# Small-team MCP gateway ("docker run" edition).
#
# Fronts one or more MCP servers with a role -> tool allowlist and tool-call
# logging, configured by a single mounted gateway.yaml. No Redis, no admin
# portal, no tenant API keys. Slim: excludes torch / vLLM / redis, so model-grade
# DLP/injection is opt-in via `enforcement_backend: http` to a Shield backend.
#
# Build:  docker build -f Dockerfile.gateway -t shield-mcp-gateway .
# Run:    docker run -p 8080:8080 -v $PWD/gateway.yaml:/etc/mcp-gateway/gateway.yaml shield-mcp-gateway
FROM python:3.12-slim

WORKDIR /app

COPY requirements-gateway.txt .
RUN pip install --no-cache-dir -r requirements-gateway.txt

# The shared in-process enforcement graph (all pure Python). The image stays slim
# because torch / vLLM / redis are excluded, not because of a per-file COPY.
COPY core/ core/
COPY config/ config/
COPY guardrails/ guardrails/
COPY api/ api/
COPY storage/ storage/

# The scanner, for the optional boot pre-flight (preflight.scan: true).
COPY packages/shield-mcp/ packages/shield-mcp/
RUN pip install --no-cache-dir ./packages/shield-mcp

# User config is mounted here (kept out of the repo `config/` package namespace).
ENV GATEWAY_CONFIG=/etc/mcp-gateway/gateway.yaml
ENV PORT=8080
EXPOSE 8080

CMD ["python", "-m", "core.mcp.gateway_lite"]
