# LLM Shield Environment Configuration
# Copy this file to .env and fill in your actual values

# RunPod Configuration (for hosted deployments)
RUNPOD_TOKEN=your-runpod-api-token-here
RUNPOD_HOST=https://your-endpoint.api.runpod.ai

# Shield Admin Configuration
SHIELD_ADMIN_KEY=your-shield-admin-key-here

# Redis Configuration (optional - for multi-tenant setups)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# Test Configuration (optional)
TENANT_ID=your-test-tenant-id
TENANT_API_KEY=your-tenant-api-key
AGENT_KEY=your-agent-key

# OpenAI Configuration (optional - for LLM validation)
OPENAI_API_KEY=your-openai-key-here

# Guardrail model (data plane vLLM server) — optional overrides
# Default (no vars set) serves votal-ai/vai35-4B-v2 with the historical flags.
# To serve NVIDIA's content-safety model instead (single vLLM server, one GPU,
# guardrail prompts unchanged), set:
# MODEL_NAME=nvidia/Nemotron-3.5-Content-Safety
# VLLM_NOTHINK_SUFFIX=false       # Qwen-only suffix; off for non-Qwen models
# VLLM_QUANTIZATION=none          # start bf16; re-enable fp8 after GPU smoke test
# VLLM_KV_CACHE_DTYPE=none
# VLLM_PERFORMANCE_MODE=none      # version-sensitive flag; omit unless smoke-tested
# VLLM_LANGUAGE_MODEL_ONLY=true   # text-only serving (skip vision tower)
# SERVED_MODEL_NAME=nemotron_moderator   # optional /v1/models alias
# HF_TOKEN=hf_...                 # only if the Hugging Face repo is gated

# Additional Environment Variables
# DEBUG=true
# LOG_LEVEL=info