{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.votal/claude_code_hook.sh\" --target codex || exit 2",
            "timeout": 30,
            "statusMessage": "Votal Shield: checking this call"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.votal/claude_code_hook.sh\" --target codex",
            "timeout": 30,
            "statusMessage": "Votal Shield: checking the result"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.votal/claude_code_hook.sh\" --target codex",
            "timeout": 30,
            "statusMessage": "Votal Shield: checking the request"
          }
        ]
      }
    ]
  }
}
