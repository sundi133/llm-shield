# Copy to .env and fill in. .env is git-ignored — never commit real keys.

SHIELD_URL=http://api.guardrails.votal.ai      # your guardrails DATA plane
TENANT_KEY=bank-co-key                          # your tenant API key
AGENT_KEY=customer-service-agent                # the already-registered agent
GATEWAY_ROUTE=bankco                            # any route name you like
UPSTREAM_URL=http://localhost:9100/mcp          # where bank_upstream.py runs

# Only if the data plane sits behind a RunPod / reverse proxy (adds Bearer):
# RUNPOD_TOKEN=rpa_...
