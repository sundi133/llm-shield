# Copy to .env and fill in. Never commit the real .env.

# --- required ---
SHIELD_URL=https://your-shield-data-plane-host          # Votal Shield base URL
SHIELD_TENANT_KEY=sk-test-demo                          # tenant API key (any sk-test- hits the sandbox tenant)

# --- optional ---
AGENT_ID=example-mcp-server                             # agent identity in Shield's registry
REGISTER_ON_BOOT=1                                       # self-register role->tool policy on start
SHIELD_FAIL_OPEN=                                        # =1 to allow calls when Shield is unreachable (default: fail closed)
SHIELD_DEFAULT_ROLE=                                     # role used when a request has no X-User-Role header (empty = unprivileged)
RUNPOD_TOKEN=                                            # only if your Shield is behind a RunPod/reverse proxy (Bearer)
PORT=8000                                                # host injects this (Railway sets it automatically)
