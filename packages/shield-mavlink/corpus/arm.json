        },
        {
          "id": "rtl-too-high",
          "expect": "deny",
          "rule": "max",
          "set": {
            "rtl_altitude_m": 200
          }
        },
        {
          "id": "no-waypoints",
          "expect": "deny",
          "rule": "min",
          "set": {
            "mission_waypoints": 0
          }
        },
        {
          "id": "too-many-waypoints",
          "expect": "deny",
          "rule": "max",
          "set": {
            "mission_waypoints": 900
          }
        },
