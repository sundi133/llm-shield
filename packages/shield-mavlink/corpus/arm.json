{
  "corpus": "arm-authorization",
  "note": "Labelled cases. `expect` is ground truth, not what the engine currently does: a case whose expectation was edited to match a regression stops being a test. `rule` names the family that should refuse, so a refusal for the wrong reason is caught. `set` assigns, `unset` removes.",
  "baseline": {
    "aircraft_id": "AB-1234",
    "mission_id": "perimeter-001",
    "operator_id": "OP-01234",
    "firmware_hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "geofence_uploaded": true,
    "mission_uploaded": true,
    "operator_role": "pilot_in_command",
    "operator_cert_valid": true,
    "mission_authorized": true,
    "gps_fix_type": "3d_fix",
    "ekf_status": "healthy",
    "compass_calibrated": true,
    "rc_link": "ok",
    "payload_state": "safed",
    "gimbal_state": "stowed",
    "airspace_clearance": "granted",
    "flight_category": "routine",
    "max_relative_altitude_m": 95,
    "battery_pct": 72,
    "battery_cell_v": 4.0,
    "reserve_pct_on_arrival": 40,
    "distance_from_home_m": 220,
    "rtl_altitude_m": 40,
    "mission_waypoints": 12,
    "gps_satellites": 14,
    "gps_hdop": 0.8,
    "wind_ms": 5,
    "gust_ms": 8,
    "visibility_m": 5000,
    "precipitation_mmh": 0.0,
    "temperature_c": 18,
    "local_hour": 13,
    "payload_mass_kg": 1.2,
    "hours_since_service": 40,
    "operator_cert_days_remaining": 90,
    "note": "routine"
  },
  "cases": [
    {
      "id": "clean",
      "expect": "allow",
      "why": "an ordinary sortie must not be refused; false positives are how guardrails get switched off"
    },
    {
      "id": "no-aircraft-id",
      "expect": "deny",
      "rule": "required",
      "unset": [
        "aircraft_id"
      ]
    },
    {
      "id": "no-mission-id",
      "expect": "deny",
      "rule": "required",
      "unset": [
        "mission_id"
      ]
    },
    {
      "id": "no-operator-id",
      "expect": "deny",
      "rule": "required",
      "unset": [
        "operator_id"
      ],
      "why": "an unattributed arm is not auditable, which defeats the record"
    },
    {
      "id": "no-firmware-hash",
      "expect": "deny",
      "rule": "required",
      "unset": [
        "firmware_hash"
      ],
      "why": "unknown software on the airframe; PX4 will fly it, policy should not authorize it"
    },
    {
      "id": "no-geofence-flag",
      "expect": "deny",
      "rule": "required",
      "unset": [
        "geofence_uploaded"
      ]
    },
    {
      "id": "no-mission-flag",
      "expect": "deny",
      "rule": "required",
      "unset": [
        "mission_uploaded"
      ]
    },
    {
      "id": "empty-mission-id",
      "expect": "deny",
      "rule": "required",
      "set": {
        "mission_id": ""
      },
      "why": "empty is absent; treating '' as present is a classic gap"
    },
    {
      "id": "bypass-geofence",
      "expect": "deny",
      "rule": "forbidden",
      "set": {
        "bypass_geofence": true
      }
    },
    {
      "id": "override-policy",
      "expect": "deny",
      "rule": "forbidden",
      "set": {
        "override_policy": true
      }
    },
    {
      "id": "raw-mavlink",
      "expect": "deny",
      "rule": "forbidden",
      "set": {
        "raw_mavlink": "COMMAND_LONG(400,1,0,0,0,0,0,0)"
      }
    },
    {
      "id": "disable-audit",
      "expect": "deny",
      "rule": "forbidden",
      "set": {
        "disable_audit": true
      },
      "why": "a request to stop recording is itself the thing most worth recording"
    },
    {
      "id": "force-arm",
      "expect": "deny",
      "rule": "forbidden",
      "set": {
        "force_arm": true
      }
    },
    {
      "id": "role-observer",
      "expect": "deny",
      "rule": "allowed_values",
      "set": {
        "operator_role": "observer"
      }
    },
    {
      "id": "role-escalated",
      "expect": "deny",
      "rule": "allowed_values",
      "set": {
        "operator_role": "root"
      }
    },
    {
      "id": "cert-invalid",
      "expect": "deny",
      "rule": "allowed_values",
      "set": {
        "operator_cert_valid": false
      }
    },
    {
      "id": "mission-unauthorized",
      "expect": "deny",
      "rule": "allowed_values",
      "set": {
        "mission_authorized": false
      },
      "why": "a well-formed mission nobody signed off is still unauthorized"
    },
    {
      "id": "geofence-not-uploaded",
      "expect": "deny",
      "rule": "allowed_values",
      "set": {
        "geofence_uploaded": false
      },
      "why": "the fence must be ON the aircraft, not merely drawn in the office"
    },
    {
      "id": "mission-not-uploaded",
      "expect": "deny",
      "rule": "allowed_values",
      "set": {
        "mission_uploaded": false
      }
    },
    {
      "id": "gps-no-fix",
      "expect": "deny",
      "rule": "allowed_values",
      "set": {
        "gps_fix_type": "no_fix"
      }
    },
    {
      "id": "gps-2d-only",
      "expect": "deny",
      "rule": "allowed_values",
      "set": {
        "gps_fix_type": "2d_fix"
      },
      "why": "2D has no altitude, so every vertical limit becomes unenforceable"
    },
    {
      "id": "ekf-unhealthy",
      "expect": "deny",
      "rule": "allowed_values",
      "set": {
        "ekf_status": "degraded"
      }
    },
    {
      "id": "compass-uncalibrated",
      "expect": "deny",
      "rule": "allowed_values",
      "set": {
        "compass_calibrated": false
      }
    },
    {
      "id": "rc-link-lost",
      "expect": "deny",
      "rule": "allowed_values",
      "set": {
        "rc_link": "lost"
      }
    },
    {
      "id": "rc-not-required-ok",
      "expect": "allow",
      "set": {
        "rc_link": "not_required"
      },
      "why": "BVLOS operations legitimately fly without an RC link"
    },
    {
      "id": "payload-armed",
      "expect": "deny",
      "rule": "allowed_values",
      "set": {
        "payload_state": "armed"
      },
      "why": "a live payload on the ground is a different risk class"
    },
    {
      "id": "gimbal-deployed",
      "expect": "deny",
      "rule": "allowed_values",
      "set": {
        "gimbal_state": "deployed"
      }
    },
    {
      "id": "no-airspace-clearance",
      "expect": "deny",
      "rule": "allowed_values",
      "set": {
        "airspace_clearance": "denied"
      }
    },
    {
      "id": "unknown-flight-category",
      "expect": "deny",
      "rule": "allowed_values",
      "set": {
        "flight_category": "test"
      }
    },
    {
      "id": "ceiling-exceeded",
      "expect": "deny",
      "rule": "max",
      "set": {
        "max_relative_altitude_m": 400
      }
    },
    {
      "id": "ceiling-exact",
      "expect": "allow",
      "set": {
        "max_relative_altitude_m": 120
      },
      "why": "boundary: at the limit is inside it, and an off-by-one grounds legitimate flights"
    },
    {
      "id": "ceiling-one-over",
      "expect": "deny",
      "rule": "max",
      "set": {
        "max_relative_altitude_m": 121
      }
    },
    {
      "id": "altitude-negative",
      "expect": "deny",
      "rule": "min",
      "set": {
        "max_relative_altitude_m": -5
      }
    },
    {
      "id": "altitude-non-numeric",
      "expect": "deny",
      "rule": "numeric",
      "set": {
        "max_relative_altitude_m": "high"
      },
      "why": "a string where a number belongs must refuse, not coerce"
    },
    {
      "id": "battery-low",
      "expect": "deny",
      "rule": "min",
      "set": {
        "battery_pct": 11
      }
    },
    {
      "id": "battery-exact",
      "expect": "allow",
      "set": {
        "battery_pct": 30
      }
    },
    {
      "id": "cell-undervolt",
      "expect": "deny",
      "rule": "min",
      "set": {
        "battery_cell_v": 3.2
      },
      "why": "pack percentage can look fine while one cell is sagging"
    },
    {
      "id": "cell-overvolt",
      "expect": "deny",
      "rule": "max",
      "set": {
        "battery_cell_v": 4.4
      }
    },
    {
      "id": "reserve-insufficient",
      "expect": "deny",
      "rule": "min",
      "set": {
        "reserve_pct_on_arrival": 8
      }
    },
    {
      "id": "too-far",
      "expect": "deny",
      "rule": "max",
      "set": {
        "distance_from_home_m": 4000
      }
    },
    {
      "id": "negative-distance",
      "expect": "deny",
      "rule": "min",
      "set": {
        "distance_from_home_m": -50
      }
    },
    {
      "id": "rtl-too-low",
      "expect": "deny",
      "rule": "min",
      "set": {
        "rtl_altitude_m": 5
      },
      "why": "an RTL below the obstacle environment returns the aircraft through it"
    },
    {
      "id": "rtl-too-high",
      "expect": "deny",
      "rule": "max",
      "set": {
        "rtl_altitude_m": 200
      }
    },
    {
      "id": "no-waypoints",
      "expect": "deny",
      "rule": "min",
      "set": {
        "mission_waypoints": 0
      }
    },
    {
      "id": "too-many-waypoints",
      "expect": "deny",
      "rule": "max",
      "set": {
        "mission_waypoints": 900
      }
    },
    {
      "id": "few-satellites",
      "expect": "deny",
      "rule": "min",
      "set": {
        "gps_satellites": 4
      }
    },
    {
      "id": "poor-hdop",
      "expect": "deny",
      "rule": "max",
      "set": {
        "gps_hdop": 4.0
      },
      "why": "a 3D fix with bad geometry is a fix that will not hold position"
    },
    {
      "id": "wind-over-limit",
      "expect": "deny",
      "rule": "max",
      "set": {
        "wind_ms": 24
      }
    },
    {
      "id": "gusts-over-limit",
      "expect": "deny",
      "rule": "max",
      "set": {
        "gust_ms": 22
      },
      "why": "mean wind within limits while gusts are not is the usual shape of a bad day"
    },
    {
      "id": "poor-visibility",
      "expect": "deny",
      "rule": "min",
      "set": {
        "visibility_m": 200
      }
    },
    {
      "id": "heavy-rain",
      "expect": "deny",
      "rule": "max",
      "set": {
        "precipitation_mmh": 9.0
      }
    },
    {
      "id": "too-cold",
      "expect": "deny",
      "rule": "min",
      "set": {
        "temperature_c": -25
      },
      "why": "cold collapses usable battery capacity, so the reserve calculation stops holding"
    },
    {
      "id": "too-hot",
      "expect": "deny",
      "rule": "max",
      "set": {
        "temperature_c": 52
      }
    },
    {
      "id": "outside-hours-early",
      "expect": "deny",
      "rule": "min",
      "set": {
        "local_hour": 4
      }
    },
    {
      "id": "outside-hours-late",
      "expect": "deny",
      "rule": "max",
      "set": {
        "local_hour": 23
      }
    },
    {
      "id": "payload-too-heavy",
      "expect": "deny",
      "rule": "max",
      "set": {
        "payload_mass_kg": 6.0
      }
    },
    {
      "id": "service-overdue",
      "expect": "deny",
      "rule": "max",
      "set": {
        "hours_since_service": 260
      }
    },
    {
      "id": "cert-expired",
      "expect": "deny",
      "rule": "min",
      "set": {
        "operator_cert_days_remaining": 0
      },
      "why": "a certificate that lapses today lapses mid-sortie"
    },
    {
      "id": "aircraft-id-malformed",
      "expect": "deny",
      "rule": "regex",
      "set": {
        "aircraft_id": "rogue-1"
      }
    },
    {
      "id": "aircraft-id-lowercase",
      "expect": "deny",
      "rule": "regex",
      "set": {
        "aircraft_id": "ab-1234"
      },
      "why": "anchored pattern, so case matters"
    },
    {
      "id": "aircraft-id-suffixed",
      "expect": "deny",
      "rule": "regex",
      "set": {
        "aircraft_id": "AB-1234x"
      },
      "why": "fullmatch, not search: a valid prefix is not a valid id"
    },
    {
      "id": "mission-id-malformed",
      "expect": "deny",
      "rule": "regex",
      "set": {
        "mission_id": "Perimeter 001!"
      }
    },
    {
      "id": "operator-id-malformed",
      "expect": "deny",
      "rule": "regex",
      "set": {
        "operator_id": "alice"
      }
    },
    {
      "id": "firmware-hash-short",
      "expect": "deny",
      "rule": "regex",
      "set": {
        "firmware_hash": "abc123"
      },
      "why": "a truncated hash is an unverifiable one"
    },
    {
      "id": "note-too-long",
      "expect": "deny",
      "rule": "max_length",
      "set": {
        "note": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      }
    },
    {
      "id": "note-absent",
      "expect": "allow",
      "unset": [
        "note"
      ],
      "why": "an optional field being absent is not a violation"
    },
    {
      "id": "deviation-reason-too-long",
      "expect": "deny",
      "rule": "max_length",
      "set": {
        "deviation_reason": ""
      }
    }
  ]
}
