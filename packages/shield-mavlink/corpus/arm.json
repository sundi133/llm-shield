        },
        {
          "id": "cell-overvolt",
          "expect": "deny",
          "rule": "max",
          "set": {
            "battery_cell_v": 4.4
          }
        },
        {
          "id": "reserve-insufficient",
          "expect": "deny",
          "rule": "min",
          "set": {
            "reserve_pct_on_arrival": 8
          }
        },
        {
          "id": "too-far",
          "expect": "deny",
          "rule": "max",
          "set": {
