{
  "corpus": "drone-guardrails",
  "note": "Labelled cases. `expect` is ground truth, not what the engine currently does: a case whose expectation was edited to match a regression stops being a test. `rule` names the family that should refuse, so a refusal for the wrong reason is caught. `set` assigns, `unset` removes.",
  "tools": {
    "arm": {
      "baseline": {
        "aircraft_id": "AB-1234",
        "mission_id": "perimeter-001",
        "operator_id": "OP-01234",
        "firmware_hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "geofence_uploaded": true,
        "mission_uploaded": true,
        "operator_role": "pilot_in_command",
        "operator_cert_valid": true,
        "mission_authorized": true,
        "gps_fix_type": "3d_fix",
        "ekf_status": "healthy",
        "compass_calibrated": true,
        "rc_link": "ok",
        "payload_state": "safed",
        "gimbal_state": "stowed",
        "airspace_clearance": "granted",
        "flight_category": "routine",
        "max_relative_altitude_m": 95,
        "battery_pct": 72,
        "battery_cell_v": 4.0,
        "reserve_pct_on_arrival": 40,
        "distance_from_home_m": 220,
        "rtl_altitude_m": 40,
        "mission_waypoints": 12,
        "gps_satellites": 14,
        "gps_hdop": 0.8,
        "wind_ms": 5,
        "gust_ms": 8,
        "visibility_m": 5000,
        "precipitation_mmh": 0.0,
        "temperature_c": 18,
        "local_hour": 13,
        "payload_mass_kg": 1.2,
        "hours_since_service": 40,
        "operator_cert_days_remaining": 90,
        "note": "routine",
        "detector_model_hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "camera_status": "ok",
        "camera_storage_state": "ok",
        "camera_storage_free_pct": 60,
        "detector_status": "ok",
        "detector_confidence_floor": 0.7,
        "network_posture": "offline",
        "log_storage_state": "ok",
        "log_storage_free_pct": 70,
        "log_chain_state": "intact",
        "unsynced_log_records": 120
      },
      "cases": [
        {
          "id": "clean",
          "expect": "allow",
          "why": "an ordinary sortie must not be refused; false positives are how guardrails get switched off"
        },
        {
          "id": "no-aircraft-id",
          "expect": "deny",
          "rule": "required",
          "unset": [
            "aircraft_id"
          ]
        },
        {
          "id": "no-mission-id",
          "expect": "deny",
          "rule": "required",
          "unset": [
            "mission_id"
          ]
        },
        {
          "id": "no-operator-id",
          "expect": "deny",
          "rule": "required",
          "unset": [
            "operator_id"
          ],
          "why": "an unattributed arm is not auditable, which defeats the record"
        },
        {
          "id": "no-firmware-hash",
          "expect": "deny",
          "rule": "required",
          "unset": [
            "firmware_hash"
          ],
          "why": "unknown software on the airframe; PX4 will fly it, policy should not authorize it"
        },
        {
          "id": "no-geofence-flag",
          "expect": "deny",
          "rule": "required",
          "unset": [
            "geofence_uploaded"
          ]
        },
        {
          "id": "no-mission-flag",
          "expect": "deny",
          "rule": "required",
          "unset": [
            "mission_uploaded"
          ]
        },
        {
          "id": "empty-mission-id",
          "expect": "deny",
          "rule": "required",
          "set": {
            "mission_id": ""
          },
          "why": "empty is absent; treating '' as present is a classic gap"
        },
        {
          "id": "bypass-geofence",
          "expect": "deny",
          "rule": "forbidden",
          "set": {
            "bypass_geofence": true
          }
        },
        {
          "id": "override-policy",
          "expect": "deny",
          "rule": "forbidden",
          "set": {
            "override_policy": true
          }
        },
        {
          "id": "raw-mavlink",
          "expect": "deny",
          "rule": "forbidden",
          "set": {
