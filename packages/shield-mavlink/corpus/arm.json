        },
        {
          "id": "poor-hdop",
          "expect": "deny",
          "rule": "max",
          "set": {
            "gps_hdop": 4.0
          },
          "why": "a 3D fix with bad geometry is a fix that will not hold position"
        },
        {
          "id": "wind-over-limit",
          "expect": "deny",
          "rule": "max",
          "set": {
            "wind_ms": 24
          }
        },
        {
          "id": "gusts-over-limit",
          "expect": "deny",
          "rule": "max",
          "set": {
            "gust_ms": 22
          },
          "why": "mean wind within limits while gusts are not is the usual shape of a bad day"
        },
        {
          "id": "poor-visibility",
          "expect": "deny",
          "rule": "min",
          "set": {
            "visibility_m": 200
          }
        },
        {
          "id": "heavy-rain",
          "expect": "deny",
          "rule": "max",
          "set": {
            "precipitation_mmh": 9.0
          }
        },
        {
          "id": "too-cold",
          "expect": "deny",
          "rule": "min",
          "set": {
            "temperature_c": -25
          },
          "why": "cold collapses usable battery capacity, so the reserve calculation stops holding"
        },
        {
          "id": "too-hot",
          "expect": "deny",
          "rule": "max",
          "set": {
            "temperature_c": 52
