          "why": "a well-formed mission nobody signed off is still unauthorized"
        },
        {
          "id": "geofence-not-uploaded",
          "expect": "deny",
          "rule": "allowed_values",
          "set": {
            "geofence_uploaded": false
          },
          "why": "the fence must be ON the aircraft, not merely drawn in the office"
