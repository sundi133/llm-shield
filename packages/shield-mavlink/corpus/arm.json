        {
          "id": "compass-uncalibrated",
          "expect": "deny",
          "rule": "allowed_values",
          "set": {
            "compass_calibrated": false
          }
        },
        {
          "id": "rc-link-lost",
          "expect": "deny",
          "rule": "allowed_values",
          "set": {
