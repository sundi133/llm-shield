{
  "policy": "arm-authorization",
  "note": "Pre-flight rules plus the runtime actions an arm gate structurally cannot cover. Arming checks subsystem STATE at one moment; camera capture, payload release, upload and log erase all happen after that gate is finished, so each needs its own policy. Same engine, keyed by tool.",
  "parameter_policies": {
    "arm": {
      "required_fields": [
        "aircraft_id",
        "mission_id",
        "operator_id",
        "firmware_hash",
        "geofence_uploaded",
        "mission_uploaded",
        "detector_model_hash"
      ],
      "forbidden_fields": [
        "bypass_geofence",
        "override_policy",
        "raw_mavlink",
        "disable_audit",
        "force_arm"
      ],
      "allowed_values": {
        "operator_role": [
          "pilot",
          "pilot_in_command"
        ],
        "operator_cert_valid": [
          true
        ],
        "mission_authorized": [
          true
        ],
        "geofence_uploaded": [
          true
        ],
        "mission_uploaded": [
          true
        ],
        "gps_fix_type": [
          "3d_fix",
          "rtk_fixed",
          "rtk_float"
        ],
        "ekf_status": [
          "healthy"
        ],
        "compass_calibrated": [
          true
        ],
        "rc_link": [
          "ok",
          "not_required"
        ],
        "payload_state": [
          "safed",
          "none"
        ],
        "gimbal_state": [
          "stowed",
          "none"
        ],
        "airspace_clearance": [
          "granted",
          "not_required"
        ],
        "flight_category": [
          "routine",
          "training",
          "emergency"
        ],
        "camera_status": [
          "ok",
          "not_fitted"
        ],
        "camera_storage_state": [
          "ok"
        ],
        "detector_status": [
          "ok",
          "not_fitted"
        ],
        "network_posture": [
          "offline",
          "approved_uplink"
        ],
        "log_storage_state": [
          "ok"
        ],
        "log_chain_state": [
          "intact"
        ]
      },
      "numeric_limits": {
        "max_relative_altitude_m": {
          "min": 0,
          "max": 120
        },
        "battery_pct": {
          "min": 30
        },
        "battery_cell_v": {
          "min": 3.6,
          "max": 4.25
        },
        "reserve_pct_on_arrival": {
          "min": 25
        },
        "distance_from_home_m": {
          "min": 0,
          "max": 500
        },
        "rtl_altitude_m": {
          "min": 20,
          "max": 120
        },
        "mission_waypoints": {
          "min": 1,
          "max": 200
        },
        "gps_satellites": {
          "min": 8
        },
        "gps_hdop": {
          "max": 1.5
        },
        "wind_ms": {
          "max": 10
        },
        "gust_ms": {
          "max": 14
        },
        "visibility_m": {
          "min": 1000
        },
        "precipitation_mmh": {
          "max": 2
        },
        "temperature_c": {
          "min": -10,
          "max": 45
        },
        "local_hour": {
          "min": 7,
          "max": 19
        },
        "payload_mass_kg": {
          "max": 2.5
        },
        "hours_since_service": {
          "max": 100
        },
        "operator_cert_days_remaining": {
          "min": 1
        },
        "camera_storage_free_pct": {
          "min": 15
        },
        "detector_confidence_floor": {
          "min": 0.5,
          "max": 0.99
        },
        "log_storage_free_pct": {
          "min": 20
        },
        "unsynced_log_records": {
          "max": 50000
        }
      },
      "regex_rules": {
        "aircraft_id": "^[A-Z]{2}-[0-9]{4}$",
        "mission_id": "^[a-z0-9][a-z0-9-]{2,63}$",
        "operator_id": "^OP-[0-9]{5}$",
        "firmware_hash": "^[a-f0-9]{64}$",
        "detector_model_hash": "^[a-f0-9]{64}$"
      },
      "max_string_lengths": {
        "note": 64,
        "deviation_reason": 256
      }
    },
    "camera_capture": {
      "required_fields": [
        "mission_id",
        "asset_tag"
      ],
      "forbidden_fields": [
        "disable_redaction",
        "raw_frame_export"
      ],
      "allowed_values": {
        "camera_status": [
          "ok"
        ],
        "over_people": [
          false
        ]
      },
      "numeric_limits": {
        "agl_m": {
          "min": 5
        },
        "camera_storage_free_pct": {
          "min": 5
        }
      },
      "regex_rules": {
        "asset_tag": "^[A-Z]{2}-[0-9]{4}$"
      }
    },
    "payload_release": {
      "required_fields": [
        "mission_id",
        "release_authorization"
      ],
      "forbidden_fields": [
        "force_release"
      ],
      "allowed_values": {
        "payload_state": [
          "armed_for_release"
        ],
        "over_people": [
          false
        ],
        "release_authorization": [
          true
        ]
      },
      "numeric_limits": {
        "agl_m": {
          "min": 10,
          "max": 120
        },
        "ground_speed_ms": {
          "max": 3
        },
        "wind_ms": {
          "max": 8
        }
      }
    },
    "upload_media": {
      "required_fields": [
        "mission_id",
        "destination"
      ],
      "forbidden_fields": [
        "disable_redaction"
      ],
      "allowed_values": {
        "destination": [
          "https://evidence.votal.example",
          "s3://votal-evidence"
        ],
        "network_posture": [
          "approved_uplink"
        ],
        "redaction_applied": [
          true
        ]
      },
      "numeric_limits": {
        "payload_mb": {
          "max": 2048
        }
      }
    },
    "log_erase": {
      "required_fields": [
        "mission_id",
        "operator_id",
        "erase_authorization"
      ],
      "forbidden_fields": [
        "force_erase",
        "skip_sync"
      ],
      "allowed_values": {
        "erase_authorization": [
          true
        ],
        "log_sync_state": [
          "synced"
        ],
        "log_chain_state": [
          "intact"
        ]
      },
      "numeric_limits": {
        "unsynced_log_records": {
          "max": 0
        }
      }
    }
  },
