<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.votal.device-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Application Support/Votal/DeviceAgent/bin/votal-device-agent</string>
    <string>service</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Library/Logs/Votal/agent.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/Votal/agent.log</string>
</dict>
</plist>
